---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { GITHUB_URL } from '../consts';
import { projects } from '../data/projects';
import { withBase } from '../utils/url';

const featured = projects[0];
---

<BaseLayout>
  <section class="hero">
    <h1>Hi, I'm Liad.</h1>
    <p class="lead">
      I build software, from low-level C graphics to Python tools and experiments.
      This is where I share what I'm working on.
    </p>
    <div class="actions">
      <a class="btn btn--primary" href={withBase('/projects')}>See my projects</a>
      <a class="btn" href={GITHUB_URL}>GitHub</a>
    </div>
  </section>

  <section>
    <h2>About</h2>
    <p>
      I like learning by building: visualizing algorithms, writing small utilities,
      and trying out new ideas. Have a look around, or check out my code on GitHub.
    </p>
  </section>

  {
    featured && (
      <section>
        <h2>Featured project</h2>
        <ProjectCard project={featured} />
      </section>
    )
  }
</BaseLayout>
