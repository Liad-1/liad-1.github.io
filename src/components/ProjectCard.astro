---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="card">
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  <ul class="tags">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <p class="card__links">
    <a href={project.repo}>View on GitHub →</a>
    {project.url && <a href={project.url}>Live demo →</a>}
  </p>
</article>
