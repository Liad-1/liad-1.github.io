---
import type { Project } from '../data/projects';
import { withBase } from '../utils/url';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article class:list={['card', 'project-card', { 'card--featured': featured }]}>
  {featured && <p class="card__eyebrow">Featured</p>}
  <h3>{project.title}</h3>
  <p>{project.description}</p>
  <ul class="tags">
    {project.tags.map((tag) => <li>{tag}</li>)}
  </ul>
  <p class="card__links">
    {project.demo && <a class="btn btn--primary" href={withBase(project.demo)}>▶ Launch</a>}
    <a href={project.repo}>View on GitHub →</a>
    {project.url && <a href={project.url}>Live demo →</a>}
  </p>
</article>
