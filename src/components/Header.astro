---
import { SITE_TITLE, NAV_LINKS } from '../consts';
import { withBase } from '../utils/url';

const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const current = normalize(Astro.url.pathname);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-name" href={withBase('/')}>
      <span class="site-name__mark" aria-hidden="true">|ψ⟩</span>
      {SITE_TITLE}
    </a>
    <nav aria-label="Main">
      <ul class="nav-links">
        {
          NAV_LINKS.map(({ href, label }) => {
            const full = withBase(href);
            const active = !href.includes('#') && normalize(full) === current;
            const section = href.includes('#') ? href.split('#')[1] : undefined;
            return (
              <li>
                <a href={full} aria-current={active ? 'page' : undefined} data-section={section}>
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
